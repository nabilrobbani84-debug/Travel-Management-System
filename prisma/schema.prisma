// Prisma Schema for Travel Management System
// Advanced Backend Engineer Architecture

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum BookingStatus {
  PENDING
  RESERVED
  WAITING_PAYMENT
  PAID
  CONFIRMED
  ON_TRIP
  COMPLETED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum PaymentMethod {
  BCA_VA
  MANDIRI_VA
  BRI_VA
  BNI_VA
  QRIS
  GOPAY
  OVO
  CREDIT_CARD
  BANK_TRANSFER
}

enum ScheduleStatus {
  AVAILABLE
  ALMOST_FULL
  FULL
  CANCELLED
  COMPLETED
}

enum TravelerType {
  ADULT
  CHILD
  INFANT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  fullName        String
  phone           String?         @unique
  passwordHash    String
  role            UserRole        @default(CUSTOMER)
  avatarUrl       String?
  isVerified      Boolean         @default(false)
  verificationToken String?
  resetPasswordToken String?
  resetTokenExpires  DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  bookings        Booking[]
  reviews         Review[]
  supportTickets  SupportTicket[]
  notifications   Notification[]
  auditLogs       AuditLog[]

  @@index([email])
  @@index([phone])
  @@index([role])
}

model Destination {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  country     String
  city        String
  description String          @db.Text
  latitude    Float
  longitude   Float
  timezone    String          @default("WITA (UTC+8)")
  category    String          @default("BEACH")
  imageUrl    String
  gallery     String[]
  featured    Boolean         @default(false)
  status      String          @default("ACTIVE")
  rating      Float           @default(5.0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  packages    TravelPackage[]

  @@index([slug])
  @@index([status])
  @@index([country, city])
}

model TravelPackage {
  id                  String           @id @default(cuid())
  destinationId       String
  title               String
  slug                String           @unique
  description         String           @db.Text
  duration            String           @default("3D2N")
  durationDays        Int              @default(3)
  startLocation       String
  endLocation         String
  price               Decimal          @db.Decimal(12, 2)
  discountPrice       Decimal?         @db.Decimal(12, 2)
  quota               Int
  availableQuota      Int
  minimumParticipant  Int              @default(1)
  maximumParticipant  Int              @default(20)
  status              String           @default("ACTIVE")
  featured            Boolean          @default(false)
  category            String           @default("BEACH")
  cancellationPolicy  String           @db.Text
  imageUrl            String
  gallery             String[]
  inclusions          String[]
  exclusions          String[]
  rating              Float            @default(5.0)
  reviewCount         Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?

  destination         Destination      @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  schedules           TravelSchedule[]
  itineraries         Itinerary[]
  hotels              Hotel[]
  transports          Transport[]
  bookings            Booking[]
  reviews             Review[]

  @@index([slug])
  @@index([destinationId])
  @@index([status])
  @@index([price])
}

model Itinerary {
  id            String        @id @default(cuid())
  packageId     String
  dayNumber     Int
  title         String
  description   String        @db.Text
  location      String
  startTime     String
  endTime       String
  meal          String
  transport     String
  accommodation String

  package       TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, dayNumber])
}

model Hotel {
  id          String        @id @default(cuid())
  packageId   String
  name        String
  rating      Int           @default(4)
  roomType    String
  location    String
  facilities  String[]
  imageUrl    String

  package     TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

model Transport {
  id           String        @id @default(cuid())
  packageId    String
  type         String
  provider     String
  vehicle      String
  seatCapacity Int

  package      TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

model TravelSchedule {
  id                      String         @id @default(cuid())
  packageId               String
  departureDate           DateTime       @db.Date
  returnDate              DateTime       @db.Date
  quota                   Int
  remainingQuota          Int
  status                  ScheduleStatus @default(AVAILABLE)
  seasonalSurgeMultiplier Float          @default(1.0)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  package                 TravelPackage  @relation(fields: [packageId], references: [id], onDelete: Restrict)
  bookings                Booking[]

  @@index([packageId, departureDate])
  @@index([status])
  @@index([departureDate])
}

model Booking {
  id               String               @id @default(cuid())
  bookingCode      String               @unique // e.g. TRV-2026-000001
  userId           String
  packageId        String
  scheduleId       String
  customerName     String
  customerEmail    String
  customerPhone    String
  totalTravelers   Int
  unitPrice        Decimal              @db.Decimal(12, 2)
  subtotal         Decimal              @db.Decimal(12, 2)
  discount         Decimal              @default(0) @db.Decimal(12, 2)
  couponCode       String?
  tax              Decimal              @db.Decimal(12, 2)
  serviceFee       Decimal              @db.Decimal(12, 2)
  totalAmount      Decimal              @db.Decimal(12, 2)
  bookingStatus    BookingStatus        @default(PENDING)
  paymentStatus    PaymentStatus        @default(PENDING)
  paymentMethod    PaymentMethod?
  paymentExpiresAt DateTime
  paidAt           DateTime?
  confirmedAt      DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  refundAmount     Decimal?             @db.Decimal(12, 2)
  refundStatus     String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  user             User                 @relation(fields: [userId], references: [id])
  package          TravelPackage        @relation(fields: [packageId], references: [id])
  schedule         TravelSchedule       @relation(fields: [scheduleId], references: [id])
  travelers        BookingTraveler[]
  transactions     PaymentTransaction[]
  invoice          Invoice?
  review           Review?

  @@index([bookingCode])
  @@index([userId])
  @@index([bookingStatus])
  @@index([paymentStatus])
  @@index([paymentExpiresAt])
}

model BookingTraveler {
  id              String       @id @default(cuid())
  bookingId       String
  fullName        String
  type            TravelerType @default(ADULT)
  gender          String
  dateOfBirth     DateTime     @db.Date
  nationality     String       @default("Indonesian")
  identityNumber  String
  passportNumber  String?
  passportExpired DateTime?    @db.Date
  phone           String?
  email           String?
  specialRequest  String?

  booking         Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model PaymentTransaction {
  id              String        @id @default(cuid())
  bookingId       String
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  status          PaymentStatus
  referenceNumber String        @unique
  idempotencyKey  String        @unique
  gatewayResponse Json?
  paidAt          DateTime?
  expiredAt       DateTime
  createdAt       DateTime      @default(now())

  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([referenceNumber])
  @@index([idempotencyKey])
}

model Invoice {
  id               String        @id @default(cuid())
  invoiceNumber    String        @unique // e.g. INV-2026-000001
  bookingId        String        @unique
  customerName     String
  customerEmail    String
  customerPhone    String
  packageTitle     String
  scheduleDates    String
  totalTravelers   Int
  unitPrice        Decimal       @db.Decimal(12, 2)
  subtotal         Decimal       @db.Decimal(12, 2)
  discount         Decimal       @db.Decimal(12, 2)
  tax              Decimal       @db.Decimal(12, 2)
  serviceFee       Decimal       @db.Decimal(12, 2)
  totalAmount      Decimal       @db.Decimal(12, 2)
  paymentMethod    PaymentMethod
  paymentReference String
  issuedAt         DateTime      @default(now())
  dueDate          DateTime
  status           String        @default("PAID")

  booking          Booking       @relation(fields: [bookingId], references: [id])

  @@index([invoiceNumber])
}

model Coupon {
  id                 String       @id @default(cuid())
  code               String       @unique
  name               String
  description        String
  type               DiscountType @default(PERCENTAGE)
  value              Decimal      @db.Decimal(10, 2)
  minimumTransaction Decimal      @db.Decimal(12, 2)
  maximumDiscount    Decimal?     @db.Decimal(12, 2)
  usageLimit         Int          @default(100)
  usageCount         Int          @default(0)
  userLimit          Int          @default(1)
  startDate          DateTime     @db.Date
  endDate            DateTime     @db.Date
  status             String       @default("ACTIVE")
  createdAt          DateTime     @default(now())

  @@index([code])
  @@index([status])
}

model Review {
  id           String        @id @default(cuid())
  bookingId    String        @unique
  packageId    String
  userId       String
  userName     String
  userAvatar   String?
  rating       Int
  comment      String        @db.Text
  status       String        @default("APPROVED")
  createdAt    DateTime      @default(now())

  booking      Booking       @relation(fields: [bookingId], references: [id])
  package      TravelPackage @relation(fields: [packageId], references: [id])
  user         User          @relation(fields: [userId], references: [id])

  @@index([packageId, rating])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  message   String   @db.Text
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

model SupportTicket {
  id          String           @id @default(cuid())
  ticketCode  String           @unique // e.g. TKT-2026-001
  userId      String
  userName    String
  userEmail   String
  subject     String
  status      TicketStatus     @default(OPEN)
  priority    TicketPriority   @default(MEDIUM)
  category    String           @default("GENERAL")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id])
  messages    SupportMessage[]

  @@index([ticketCode])
  @@index([userId, status])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  senderId  String
  senderName String
  senderRole UserRole
  message   String        @db.Text
  createdAt DateTime      @default(now())

  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  userName  String
  userRole  UserRole
  action    String
  entity    String
  entityId  String
  oldValue  String?  @db.Text
  newValue  String?  @db.Text
  ipAddress String
  timestamp DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([timestamp])
}
